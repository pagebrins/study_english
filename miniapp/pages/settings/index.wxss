.settings-page {
  padding-bottom: 280rpx;
}

.settings-hero,
.content-card {
  padding: 30rpx;
}

.settings-hero .section-title,
.content-card .section-title,
.content-card .section-subtitle {
  display: block;
}

.section-spacing {
  margin-top: 24rpx;
}

.field-spacing,
.settings-item-card,
.permission-row {
  margin-top: 20rpx;
}

.dual-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.hero-actions,
.task-head,
.permission-pills,
.tag-row,
.role-actions {
  display: flex;
}

.hero-actions {
  gap: 16rpx;
}

.action-button {
  flex: 1;
}

.profile-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f8fffe 0%, #ffffff 100%);
  border: 2rpx solid #ccfbf1;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.profile-meta {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 24rpx;
}

.permission-pills,
.tag-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.permission-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ecfeff 0%, #f0fdfa 100%);
  border: 2rpx solid #99f6e4;
}

.permission-pill-text {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 600;
}

.settings-item-card {
  padding: 26rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.task-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.role-actions {
  align-items: center;
  gap: 14rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.task-description {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.7;
}

.compact-actions {
  margin-top: 18rpx;
}

.permission-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.permission-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.permission-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.permission-code {
  color: #64748b;
  font-size: 22rpx;
}

.mini-picker {
  min-width: 180rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #ecfeff;
  color: #0f766e;
  text-align: center;
  font-size: 24rpx;
}

.delete-user-button {
  min-width: 96rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #fff1f2;
  border: 2rpx solid #fecdd3;
  color: #dc2626;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

.role-user-head {
  margin-top: 28rpx;
}


.menu-popover-wrap {
  position: fixed;
  right: 28rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  z-index: 29;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.menu-popover {
  width: 228rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid #dbe4ea;
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.14);
}

.popover-item {
  height: 86rpx;
  border: none;
  border-bottom: 2rpx solid #eef2f7;
  border-radius: 0;
  background: #ffffff;
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 500;
}

.popover-item:last-child {
  border-bottom: none;
}

.popover-item.active {
  background: #f0fdfa;
  color: #0f766e;
  font-weight: 600;
}

.popover-item.danger {
  color: #dc2626;
}

.popover-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-right: 44rpx;
  margin-top: -12rpx;
  background: #ffffff;
  border-right: 2rpx solid #dbe4ea;
  border-bottom: 2rpx solid #dbe4ea;
  transform: rotate(45deg);
}
