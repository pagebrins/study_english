<view class="page">
  <view class="hero-card practice-hero aurora-card">
    <text class="section-title">{{mode ? mode.name : '请先选择模式'}}</text>
    <text class="section-subtitle">
      {{mode ? ('当前方向：' + (mode.mode === 1 ? '中译英' : '英译中') + '，题量 ' + mode.numbers) : '先去“学习”页选一个今日任务，再回来生成练习题。'}}
    </text>
    <view class="hero-actions">
      <button class="primary-button action-button" bindtap="generateQuestions" loading="{{loading}}">
        {{loading ? '生成中...' : '生成题目'}}
      </button>
      <button wx:if="{{mode && canUseChat}}" class="secondary-button action-button" bindtap="goChat">AI 讲解</button>
      <button wx:else class="secondary-button action-button" bindtap="goStudy">去学习页</button>
    </view>
    <text wx:if="{{error}}" class="error-text">{{error}}</text>
  </view>

  <view wx:for="{{generated}}" wx:key="index" class="question-card question-item">
    <text class="question-index">第 {{index + 1}} 题</text>
    <text class="question-text">{{item.question}}</text>
    <button
      wx:if="{{item.question_pronunciation && item.question_pronunciation.audio_url}}"
      class="secondary-button pronunciation-button"
      data-url="{{item.question_pronunciation.audio_url}}"
      bindtap="playPronunciation"
    >
      播放英文题干
    </button>
    <textarea
      class="field-textarea"
      placeholder="请输入你的答案"
      value="{{answers[index]}}"
      data-index="{{index}}"
      bindinput="onAnswerInput"
    />
    <button class="primary-button submit-button" data-index="{{index}}" loading="{{submitting}}" bindtap="submitAnswer">
      提交答案
    </button>

    <view wx:if="{{issues[index] && issues[index].length > 0}}" class="issue-box">
      <text class="issue-title">问题反馈</text>
      <text wx:for="{{issues[index]}}" wx:key="*this" class="issue-item">{{item}}</text>
      <text class="success-text">标准答案：{{item.answer_key}}</text>
      <button
        wx:if="{{item.answer_key_pronunciation && item.answer_key_pronunciation.audio_url}}"
        class="secondary-button pronunciation-button"
        data-url="{{item.answer_key_pronunciation.audio_url}}"
        bindtap="playPronunciation"
      >
        播放英文答案
      </button>
    </view>

    <view wx:if="{{issues[index] && issues[index].length === 0}}" class="issue-box ok-box">
      <text class="success-text">回答不错，这题已经通过。</text>
    </view>
  </view>
</view>
