.mode-hero {
  padding: 36rpx;
}

.type-group {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.type-chip {
  flex: 1;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #334155;
  font-size: 26rpx;
  border: none;
}

.type-chip.active {
  background: #0f766e;
  color: #ffffff;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-button {
  flex: 1;
}

.ghost {
  height: 88rpx;
}

.feedback-card,
.mode-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.mode-card.active {
  border: 2rpx solid #14b8a6;
}

.mode-card-head,
.mode-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mode-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.mode-description {
  display: block;
  margin-top: 16rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.7;
}

.mode-meta {
  margin-top: 20rpx;
}

.meta-text,
.requirement-item {
  color: #64748b;
  font-size: 24rpx;
}

.requirement-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
