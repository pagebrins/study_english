.dashboard-page {
  padding-top: 0;
}

.overview-stage {
  margin: 0 -32rpx;
  padding: 28rpx 32rpx 16rpx;
  background:
    radial-gradient(circle at top left, rgba(15, 23, 42, 0.1), transparent 32%),
    radial-gradient(circle at top right, rgba(20, 184, 166, 0.16), transparent 30%),
    linear-gradient(180deg, #effcf9 0%, rgba(239, 252, 249, 0) 100%);
}

.overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.overview-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #0f172a;
}

.overview-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #475569;
}

.overview-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dark-role-chip {
  background: rgba(15, 23, 42, 0.08);
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-stat {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(226, 232, 240, 0.92);
}

.overview-stat-value {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.overview-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.plan-card-row {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.plan-hero-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #111318;
  border: 2rpx solid #2b303b;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.12);
}

.plan-hero-card.active {
  border-color: #dbe2ea;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.16);
}

.plan-hero-name {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #f8fafc;
}

.plan-hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #cbd5e1;
}

.plan-hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #e2e8f0;
}

.overview-detail-card,
.feed-card,
.onboarding-entry-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.compact-head {
  align-items: flex-start;
}

.type-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-chip.dark {
  min-width: 112rpx;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  color: #475569;
  font-size: 24rpx;
  line-height: 68rpx;
}

.type-chip.dark.active {
  background: #0f172a;
  border-color: #0f172a;
  color: #ffffff;
}

.detail-surface {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #111318 0%, #1b2028 100%);
}

.detail-plan-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #f8fafc;
}

.detail-plan-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #cbd5e1;
}

.detail-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-metric {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ecfeff;
  font-size: 22rpx;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-button {
  flex: 1;
}

.dark-feed-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.calendar-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.calendar-caption {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 600;
}

.calendar-head-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.calendar-month {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 700;
}

.calendar-week-head {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.calendar-week-label {
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.calendar-day-card {
  min-height: 124rpx;
  padding: 16rpx 8rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.calendar-day-card.today {
  border-color: #93c5fd;
  background: #eff6ff;
}

.calendar-day-card.plan {
  border-color: #99f6e4;
  background: #ecfeff;
}

.calendar-day-card.assessment {
  border-color: #fbbf24;
  background: #fffbeb;
}

.calendar-day-card.studied {
  border-color: #bbf7d0;
  background: #ecfdf5;
}

.calendar-day-card.missed {
  border-color: #fecaca;
  background: #fef2f2;
}

.muted-day {
  background: rgba(248, 250, 252, 0.48);
  border-color: rgba(226, 232, 240, 0.52);
}

.calendar-date {
  display: block;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  text-align: left;
}

.calendar-tag {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 20rpx;
  text-align: right;
}

.muted-day .calendar-date,
.muted-day .calendar-tag {
  color: #cbd5e1;
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
}

.assessment-dot {
  background: #fbbf24;
}

.plan-dot {
  background: #14b8a6;
}

.missed-dot {
  background: #f87171;
}

.legend-label {
  color: #64748b;
  font-size: 22rpx;
}

.feed-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 20rpx;
}

.feed-score-block {
  width: 96rpx;
  padding: 18rpx 0;
  border-radius: 22rpx;
  background: #ecfeff;
  text-align: center;
  flex-shrink: 0;
}

.feed-score {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f766e;
}

.feed-score-label {
  color: #0f766e;
  font-size: 20rpx;
}

.feed-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.feed-question,
.feed-answer,
.feed-time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.feed-question {
  margin-top: 0;
  color: #0f172a;
  font-weight: 600;
}

.feed-answer {
  color: #475569;
}

.feed-time {
  color: #94a3b8;
}

.onboarding-entry-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
}

.onboarding-entry-button {
  width: 100%;
}
