.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at top, rgba(20, 184, 166, 0.18), transparent 38%),
    linear-gradient(180deg, #ecfeff 0%, #f8fafc 55%, #ffffff 100%);
}

.login-card {
  width: 100%;
  padding: 48rpx;
}

.login-kicker {
  display: inline-flex;
  margin-bottom: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #115e59;
  font-size: 22rpx;
  font-weight: 600;
}

.login-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #0f172a;
}

.login-description {
  display: block;
  margin: 20rpx 0 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475569;
}
