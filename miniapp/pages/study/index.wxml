<view class="page page-with-bottom-space">
  <view wx:if="{{error}}" class="section-card feedback-card">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:if="{{loading}}" class="section-card feedback-card">
    <text class="muted">正在加载学习状态...</text>
  </view>

  <view wx:if="{{!loading && onboardingIncomplete}}" class="section-card onboarding-entry-card">
    <button class="primary-button onboarding-entry-button" bindtap="openOnboardingModal">开始入学测试</button>
  </view>

  <block wx:if="{{!loading && !onboardingIncomplete}}">
    <view class="section-card plan-strip-card">
      <view class="plan-button-group">
        <view wx:for="{{visibleItems}}" wx:key="id" class="{{selectedPlanItem && selectedPlanItem.id === item.id ? 'plan-button-card active' : 'plan-button-card'}}" data-id="{{item.id}}" bindtap="onChooseTask">
          <view class="plan-button-head">
            <text class="plan-button-name">{{item.name}}</text>
            <text class="plan-button-desc">{{item.description}}</text>
          </view>
          <view class="plan-button-meta-row">
            <text class="plan-button-meta">{{item.study_type === 1 ? '单词' : item.study_type === 2 ? '句子' : '文章'}}</text>
            <text class="plan-button-meta">{{item.translation_mode === 1 ? '中译英' : '英译中'}}</text>
            <text class="plan-button-meta">Lv{{item.level}}</text>
            <text class="plan-button-meta">{{item.numbers}} 题</text>
            <text class="plan-button-meta">约 {{item.estimated_minutes}} 分钟</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card question-panel-card">
      <view>
        <text class="section-title">{{selectedPlanItem ? selectedPlanItem.name : '题目练习'}}</text>
        <text wx:if="{{selectedPlanItem}}" class="section-subtitle">{{selectedPlanItem.description}} · {{selectedPlanItem.translation_mode === 1 ? '中译英' : '英译中'}}</text>
      </view>

      <view wx:if="{{generatingQuestions}}" class="question-loading-card">
        <text class="muted">正在生成题目，请稍候...</text>
      </view>

      <view wx:if="{{!generatingQuestions && generated.length > 0}}" class="question-list">
        <view wx:for="{{generated}}" wx:for-item="questionItem" wx:key="index" class="question-card question-item">
          <text class="question-index">第 {{index + 1}} 题</text>
          <text class="question-text">{{questionItem.question}}</text>
          <button
            wx:if="{{questionItem.question_pronunciation && questionItem.question_pronunciation.audio_url}}"
            class="secondary-button pronunciation-button"
            data-url="{{questionItem.question_pronunciation.audio_url}}"
            bindtap="playPronunciation"
          >
            播放英文题干
          </button>
          <textarea
            class="field-textarea"
            placeholder="请输入你的答案"
            value="{{answers[index]}}"
            data-index="{{index}}"
            bindinput="onAnswerInput"
          />
          <button class="primary-button submit-button" data-index="{{index}}" loading="{{submittingAnswerIndex === index}}" bindtap="submitAnswer">
            {{submittingAnswerIndex === index ? '提交中...' : '提交答案'}}
          </button>

          <view wx:if="{{reviewed[index] && issues[index] && issues[index].length > 0}}" class="issue-box">
            <text class="issue-title">问题反馈</text>
            <text wx:for="{{issues[index]}}" wx:for-item="issue" wx:key="*this" class="issue-item">{{issue}}</text>
            <text class="success-text">标准答案：{{questionItem.answer_key}}</text>
            <button
              wx:if="{{questionItem.answer_key_pronunciation && questionItem.answer_key_pronunciation.audio_url}}"
              class="secondary-button pronunciation-button"
              data-url="{{questionItem.answer_key_pronunciation.audio_url}}"
              bindtap="playPronunciation"
            >
              播放英文答案
            </button>
          </view>

          <view wx:if="{{reviewed[index] && issues[index] && issues[index].length === 0}}" class="issue-box ok-box">
            <text class="success-text">回答不错，这题已经通过。</text>
          </view>
        </view>
      </view>

      <text wx:if="{{!generatingQuestions && selectedPlanItem && generated.length === 0}}" class="muted empty-question-tip">正在为当前计划准备题目。</text>
      <text wx:if="{{!selectedPlanItem && visibleItems.length === 0}}" class="muted empty-question-tip">当前没有可用的学习计划。</text>
    </view>
  </block>

  <view wx:if="{{showOnboardingModal}}" class="modal-mask" catchtap="closeOnboardingModal">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head">
        <view>
          <text class="section-title">Learning Onboarding</text>
          <text class="section-subtitle">Step {{onboardingStep}} / 5</text>
        </view>
        <button class="ghost-button modal-close" bindtap="closeOnboardingModal">关闭</button>
      </view>

      <scroll-view scroll-y class="modal-scroll">
        <view wx:if="{{bundle.goal_required}}" class="modal-step">
          <text class="section-title">Step 1 · 设置学习目标</text>
          <input class="field-input field-spacing" placeholder="请输入学习目标" value="{{goal}}" bindinput="onGoalInput" />
          <input class="field-input field-spacing" type="number" placeholder="每天学习多少分钟" value="{{dailyMinutes}}" bindinput="onDailyMinutesInput" />
          <input class="field-input field-spacing" placeholder="请输入学习时间段" value="{{studyTimeRange}}" bindinput="onStudyTimeRangeInput" />
          <button class="primary-button submit-button field-spacing" loading="{{startingAssessment}}" bindtap="startInitialAssessment">{{startingAssessment ? '保存中...' : '保存目标并下一步'}}</button>
        </view>

        <view wx:if="{{!bundle.goal_required && bundle.assessment_required && onboardingStep === 2}}" class="modal-step">
          <text class="section-title">Step 2 · 单词测试</text>
          <view wx:for="{{bundle.assessment_items}}" wx:key="id">
            <view wx:if="{{item.study_type === 1}}" class="assessment-card">
              <text class="assessment-question">{{index + 1}}. {{item.question}}</text>
              <button wx:if="{{item.question_pronunciation && item.question_pronunciation.audio_url}}" class="secondary-button pronunciation-button" data-url="{{item.question_pronunciation.audio_url}}" bindtap="playPronunciation">播放英文题干</button>
              <textarea class="field-textarea" placeholder="请输入你的答案" value="{{assessmentAnswers[index]}}" data-index="{{index}}" bindinput="onAssessmentAnswerInput" />
            </view>
          </view>
          <button class="primary-button submit-button field-spacing" bindtap="goSentenceStep">下一步：句子测试</button>
        </view>

        <view wx:if="{{!bundle.goal_required && bundle.assessment_required && onboardingStep === 3}}" class="modal-step">
          <text class="section-title">Step 3 · 句子测试</text>
          <view wx:for="{{bundle.assessment_items}}" wx:key="id">
            <view wx:if="{{item.study_type === 2}}" class="assessment-card">
              <text class="assessment-question">{{index + 1}}. {{item.question}}</text>
              <button wx:if="{{item.question_pronunciation && item.question_pronunciation.audio_url}}" class="secondary-button pronunciation-button" data-url="{{item.question_pronunciation.audio_url}}" bindtap="playPronunciation">播放英文题干</button>
              <textarea class="field-textarea" placeholder="请输入你的答案" value="{{assessmentAnswers[index]}}" data-index="{{index}}" bindinput="onAssessmentAnswerInput" />
            </view>
          </view>
          <view class="hero-actions field-spacing">
            <button class="ghost-button action-button" bindtap="backToWordStep">上一步</button>
            <button class="primary-button action-button" loading="{{submittingAssessment}}" bindtap="submitAssessment">{{submittingAssessment ? '提交测试中...' : '提交测试'}}</button>
          </view>
        </view>

        <view wx:if="{{!bundle.goal_required && !bundle.assessment_required && bundle.plan_generation_required && bundle.profile}}" class="modal-step">
          <text class="section-title">Step 4 · 确认用户画像</text>
          <view class="profile-metrics">
            <text class="meta-text">学习目标 {{bundle.profile.goal}}</text>
            <text class="meta-text">每天 {{bundle.profile.daily_minutes}} 分钟</text>
            <text class="meta-text">时间段 {{bundle.profile.study_time_range || '待设置'}}</text>
            <text class="meta-text">单词 Lv{{bundle.profile.word_level}}</text>
            <text class="meta-text">句子 Lv{{bundle.profile.sentence_level}}</text>
            <text class="meta-text">综合 Lv{{bundle.profile.overall_level}}</text>
          </view>
          <view class="hero-actions field-spacing">
            <button class="secondary-button action-button soft-button" loading="{{savingGoal}}" bindtap="saveGoal">更新目标并重新测评</button>
            <button class="primary-button action-button" loading="{{generatingPlan}}" bindtap="generatePlan">{{generatingPlan ? '生成中...' : '生成学习计划'}}</button>
          </view>
        </view>

        <view wx:if="{{!bundle.goal_required && !bundle.assessment_required && !bundle.plan_generation_required && bundle.profile}}" class="modal-step">
          <text class="section-title">Step 5 · 学习计划</text>
          <text class="section-subtitle">学习计划已生成，点击上方 plan 卡片即可自动生成题目。</text>
          <button class="primary-button submit-button field-spacing" bindtap="closeOnboardingModal">完成</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
