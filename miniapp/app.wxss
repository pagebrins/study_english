page {
  background:
    radial-gradient(circle at top, rgba(45, 212, 191, 0.14), transparent 36%),
    linear-gradient(180deg, #f6fffd 0%, #f8fafc 42%, #ffffff 100%);
  color: #0f172a;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-with-bottom-space {
  padding-bottom: 48rpx;
}

.hero-card,
.section-card,
.chat-card,
.question-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
}

.aurora-card {
  background:
    radial-gradient(circle at top right, rgba(20, 184, 166, 0.24), transparent 34%),
    radial-gradient(circle at left bottom, rgba(14, 165, 233, 0.12), transparent 24%),
    linear-gradient(180deg, #ffffff 0%, #f8fffe 100%);
}

.warm-card {
  background:
    radial-gradient(circle at top right, rgba(251, 191, 36, 0.18), transparent 30%),
    radial-gradient(circle at left bottom, rgba(249, 115, 22, 0.1), transparent 24%),
    linear-gradient(180deg, #ffffff 0%, #fffaf5 100%);
}

.eyebrow {
  display: inline-flex;
  margin-bottom: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #115e59;
  font-size: 22rpx;
  font-weight: 600;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #99f6e4;
}

.ghost-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #475569;
  border: 2rpx solid #e2e8f0;
  font-size: 26rpx;
}

.soft-button {
  background: rgba(236, 254, 255, 0.88);
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 500;
}

.field-input,
.field-picker,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 2rpx solid #cbd5e1;
  background: #ffffff;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.field-textarea {
  min-height: 200rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 22rpx;
}

.muted {
  color: #64748b;
}

.error-text {
  color: #dc2626;
  font-size: 24rpx;
  line-height: 1.6;
}

.success-text {
  color: #047857;
  font-size: 24rpx;
  line-height: 1.6;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.compact-button {
  min-width: 160rpx;
  height: 72rpx;
  font-size: 24rpx;
}
