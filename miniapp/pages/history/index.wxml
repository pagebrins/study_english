<view class="page">
  <view class="hero-card history-hero">
    <text class="section-title">历史记录与复盘</text>
    <text class="section-subtitle">今日平均分 {{score}}，已答 {{answered}} 题。可以按学习类型和模式快速回看。</text>
  </view>

  <view class="section-card filter-card">
    <text class="field-label">学习类型</text>
    <picker mode="selector" range="{{['单词', '句子', '文章']}}" bindchange="onTypeChange">
      <view class="field-picker">{{selectedType === 1 ? '单词' : selectedType === 2 ? '句子' : '文章'}}</view>
    </picker>

    <text class="field-label mode-label">模式筛选</text>
    <picker mode="selector" range="{{modeOptions}}" bindchange="onModeChange">
      <view class="field-picker">{{selectedModeName}}</view>
    </picker>
  </view>

  <view wx:if="{{error}}" class="section-card filter-card">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:if="{{loading}}" class="section-card filter-card">
    <text class="muted">正在加载历史记录...</text>
  </view>

  <empty-state
    wx:if="{{!loading && !error && items.length === 0}}"
    title="还没有练习记录"
    description="先去练习页答几道题，这里就会自动沉淀下来。"
  />

  <view wx:for="{{items}}" wx:key="id" class="section-card history-card">
    <view class="history-head">
      <text class="history-index">第 {{index + 1}} 题</text>
      <text class="{{item.score >= 90 ? 'score-tag green' : 'score-tag'}}">{{item.score}} 分</text>
    </view>
    <text class="history-question">{{item.question}}</text>
    <button
      wx:if="{{item.question_pronunciation && item.question_pronunciation.audio_url}}"
      class="secondary-button ask-button"
      data-url="{{item.question_pronunciation.audio_url}}"
      bindtap="playPronunciation"
    >
      播放英文题干
    </button>
    <text class="history-answer">你的答案：{{item.answer_text || '未填写'}}</text>
    <text class="history-answer muted">标准答案：{{item.answer_key}}</text>
    <button
      wx:if="{{item.answer_key_pronunciation && item.answer_key_pronunciation.audio_url}}"
      class="secondary-button ask-button"
      data-url="{{item.answer_key_pronunciation.audio_url}}"
      bindtap="playPronunciation"
    >
      播放英文答案
    </button>
    <text class="history-time">{{item.create_time}}</text>
    <button class="secondary-button ask-button" data-index="{{index}}" bindtap="askAI">AI 讲解这题</button>
  </view>
</view>
