<view class="page page-with-bottom-space dashboard-page">
  <view class="hero-shell">
    <view class="hero-card dashboard-hero aurora-card">
      <view class="hero-topline">
        <text class="eyebrow">Today Dashboard</text>
        <text class="role-chip">{{roleName}}</text>
      </view>
      <text class="hero-title">{{userName}}，今天先把最值得做的练起来</text>
      <text class="hero-copy">
        {{!canView ? '当前账号还没有总览权限。' : bundle.goal_required ? '先完成初始水平测试，系统再根据结果安排今天的训练。' : bundle.assessment_required ? '先把这轮水平测试做完，这里会自动切换成你的今日学习看板。' : selectedModeName ? ('当前已锁定任务：' + selectedModeName) : '今天的计划已经展开，先挑一项开始。'}}
      </text>

      <view class="hero-stats">
        <view class="stat-panel emphasis">
          <text class="stat-value">{{todayAnswered}}</text>
          <text class="stat-label">今日已答</text>
        </view>
        <view class="stat-panel">
          <text class="stat-value">{{todayScore}}</text>
          <text class="stat-label">今日均分</text>
        </view>
        <view class="stat-panel">
          <text class="stat-value">{{plannedMinutes || '--'}}</text>
          <text class="stat-label">计划分钟</text>
        </view>
      </view>

      <view class="hero-actions">
        <button wx:if="{{!bundle.goal_required && !bundle.assessment_required}}" class="primary-button action-button" bindtap="goPractice">开始今天练习</button>
        <button wx:else class="primary-button action-button" bindtap="goStudy">去做水平测试</button>
        <button class="secondary-button action-button soft-button" bindtap="goStudy">进入学习页</button>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="section-card section-spacing">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:if="{{loading}}" class="section-card section-spacing">
    <text class="muted">正在整理今天的训练总览...</text>
  </view>

  <view wx:if="{{!loading && canView}}" class="focus-grid section-spacing">
    <view class="section-card focus-card spotlight-card">
      <view class="section-head compact-head">
        <view>
          <text class="section-title">今日主线</text>
          <text class="section-subtitle">优先选一条任务，把手感先打热。</text>
        </view>
        <button class="ghost-button compact-button" bindtap="goStudy">全部计划</button>
      </view>

      <view class="type-group type-group-tight">
        <button class="{{selectedType === 1 ? 'type-chip active' : 'type-chip'}}" data-value="1" bindtap="onTypeChange">单词</button>
        <button class="{{selectedType === 2 ? 'type-chip active' : 'type-chip'}}" data-value="2" bindtap="onTypeChange">句子</button>
        <button class="{{selectedType === 3 ? 'type-chip active' : 'type-chip'}}" data-value="3" bindtap="onTypeChange">文章</button>
      </view>

      <view wx:if="{{bundle.goal_required || bundle.assessment_required}}" class="focus-empty warm-surface">
        <text class="focus-title">先完成水平测试</text>
        <text class="focus-copy">先完成初始水平测试，系统会根据结果自动替你挑出今天的重点任务。</text>
        <button class="primary-button submit-button" bindtap="goStudy">去学习页测试</button>
      </view>

      <view wx:elif="{{featuredItem}}" class="featured-task" data-id="{{featuredItem.id}}" bindtap="onChooseTask">
        <view class="featured-head">
          <view>
            <text class="featured-kicker">推荐先做</text>
            <text class="featured-title">{{featuredItem.name}}</text>
          </view>
          <text class="pill">Lv{{featuredItem.level}}</text>
        </view>
        <text class="featured-copy">{{featuredItem.description}}</text>
        <view class="featured-meta">
          <text class="meta-chip">{{featuredItem.study_type === 1 ? '单词' : featuredItem.study_type === 2 ? '句子' : '文章'}}</text>
          <text class="meta-chip">{{featuredItem.translation_mode === 1 ? '中译英' : '英译中'}}</text>
          <text class="meta-chip">{{featuredItem.numbers}} 题</text>
          <text class="meta-chip">约 {{featuredItem.estimated_minutes || 0}} 分钟</text>
        </view>
      </view>

      <empty-state
        wx:else
        title="当前题型还没有任务"
        description="你可以切换题型，或者先去学习页刷新计划。"
      />
    </view>

    <view class="section-card feed-card">
      <view class="section-head compact-head">
        <view>
          <text class="section-title">最近轨迹</text>
          <text class="section-subtitle">做完后记得回看，节奏会更稳。</text>
        </view>
        <button class="ghost-button compact-button" bindtap="goHistory">全部历史</button>
      </view>

      <empty-state
        wx:if="{{recentItems.length === 0}}"
        title="还没有答题记录"
        description="去做第一轮练习，这里就会长出你的学习轨迹。"
      />

      <view wx:for="{{recentItems}}" wx:key="id" class="feed-row">
        <view class="feed-score-block">
          <text class="feed-score">{{item.score}}</text>
          <text class="feed-score-label">分</text>
        </view>
        <view class="feed-copy">
          <text class="feed-question">{{item.question}}</text>
          <text class="feed-answer">你的答案：{{item.answer_text || '未填写'}}</text>
          <text class="feed-time">{{item.create_time}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && canView && visibleItems.length > 0 && !bundle.goal_required && !bundle.assessment_required}}" class="section-card section-spacing">
    <view class="section-head compact-head">
      <view>
        <text class="section-title">备选任务</text>
        <text class="section-subtitle">如果你想换一条主线，这里直接切。</text>
      </view>
    </view>
    <scroll-view scroll-x class="task-scroll" enable-flex="true">
      <view class="task-strip">
        <view wx:for="{{visibleItems}}" wx:key="id" class="mini-task-card" data-id="{{item.id}}" bindtap="onChooseTask">
          <text class="mini-task-title">{{item.name}}</text>
          <text class="mini-task-copy">{{item.translation_mode === 1 ? '中译英' : '英译中'}} · {{item.numbers}} 题</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{!loading && canView}}" class="dashboard-quick section-spacing">
    <button class="quick-card quick-primary" bindtap="goPractice">
      <text class="quick-title">练习入口</text>
      <text class="quick-copy">{{canPractice ? '带着当前任务直接开练' : '当前账号没有练习权限'}}</text>
    </button>
    <button class="quick-card" bindtap="goHistory">
      <text class="quick-title">历史复盘</text>
      <text class="quick-copy">最近答题、得分和回看入口都在这</text>
    </button>
    <button wx:if="{{canSettings}}" class="quick-card" bindtap="goSettings">
      <text class="quick-title">设置中心</text>
      <text class="quick-copy">主题、知识库和权限按角色开放</text>
    </button>
    <view wx:if="{{canChat}}" class="quick-card muted-card">
      <text class="quick-title">AI 讲解已开启</text>
      <text class="quick-copy">练习和历史页都能继续追问细节</text>
    </view>
  </view>
</view>
