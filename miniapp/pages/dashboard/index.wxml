<view class="page page-with-bottom-space dashboard-page">
  <view wx:if="{{error}}" class="section-card section-spacing">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:if="{{loading}}" class="section-card section-spacing">
    <text class="muted">正在整理今天的训练总览...</text>
  </view>

  <view wx:if="{{!loading && canView && onboardingIncomplete}}" class="section-card onboarding-entry-card">
    <button class="primary-button onboarding-entry-button" bindtap="startOnboarding">开始入学测试</button>
  </view>

  <block wx:if="{{!loading && canView && !onboardingIncomplete}}">
    <view class="overview-stage">
      <view class="overview-head">
        <view>
          <text class="overview-title">今天学什么</text>
          <text class="overview-copy">目标：{{goalSummary || '先在学习页生成目标和学习计划。'}}</text>
        </view>
        <text class="role-chip dark-role-chip">{{roleName}}</text>
      </view>

      <view class="overview-actions">
        <button class="primary-button action-button" bindtap="goStudy">开始学习</button>
        <button class="secondary-button action-button soft-button" bindtap="goHistory">开始复习</button>
      </view>
    </view>

    <view class="section-card calendar-card">
      <view class="section-head compact-head">
        <view>
          <text class="section-title">本月学习日历</text>
          <text class="section-subtitle">按月展示入门测试日、计划日和未学习日期。</text>
        </view>
        <view class="calendar-head-meta">
          <text class="calendar-month">{{calendarMonthLabel}}</text>
          <text class="calendar-caption">{{assessmentLabel}}</text>
        </view>
      </view>

      <view class="calendar-week-head">
        <text class="calendar-week-label">Mon</text>
        <text class="calendar-week-label">Tue</text>
        <text class="calendar-week-label">Wed</text>
        <text class="calendar-week-label">Thu</text>
        <text class="calendar-week-label">Fri</text>
        <text class="calendar-week-label">Sat</text>
        <text class="calendar-week-label">Sun</text>
      </view>

      <view class="calendar-grid">
        <view wx:for="{{calendarDays}}" wx:key="key" class="{{item.isCurrentMonth ? (item.isAssessmentDay ? 'calendar-day-card assessment' : item.isPlanDay ? 'calendar-day-card plan' : item.isStudied ? 'calendar-day-card studied' : item.isMissed ? 'calendar-day-card missed' : item.isToday ? 'calendar-day-card today' : 'calendar-day-card') : 'calendar-day-card muted-day'}}">
          <text class="calendar-date">{{item.dateNumber}}</text>
          <text class="calendar-tag">{{item.isAssessmentDay ? '测试' : item.isPlanDay ? '计划' : item.isStudied ? '已学' : item.isMissed ? '未学' : item.isToday ? '今天' : ''}}</text>
        </view>
      </view>

      <view class="calendar-legend">
        <view class="legend-item">
          <text class="legend-dot assessment-dot"></text>
          <text class="legend-label">入门测试</text>
        </view>
        <view class="legend-item">
          <text class="legend-dot plan-dot"></text>
          <text class="legend-label">计划日期</text>
        </view>
        <view wx:if="{{bundle.plan && bundle.plan.plan_date}}" class="legend-item">
          <text class="legend-dot missed-dot"></text>
          <text class="legend-label">未学习</text>
        </view>
      </view>
    </view>

    <view wx:if="{{recentItems.length > 0}}" class="section-card feed-card dark-feed-card">
      <view class="section-head compact-head">
        <view>
          <text class="section-title">最近轨迹</text>
          <text class="section-subtitle">像 Web 一样，下面直接看最近几次答题记录。</text>
        </view>
        <button class="ghost-button compact-button" bindtap="goHistory">全部历史</button>
      </view>

      <view wx:for="{{recentItems}}" wx:key="id" class="feed-row">
        <view class="feed-score-block">
          <text class="feed-score">{{item.score}}</text>
          <text class="feed-score-label">分</text>
        </view>
        <view class="feed-copy">
          <text class="feed-question">{{item.question}}</text>
          <text class="feed-answer">你的答案：{{item.answer_text || '未填写'}}</text>
          <text class="feed-time">{{item.create_time}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
