<view class="page login-page">
  <view class="hero-card login-card">
    <view class="name-prompt-card">
      <input class="field-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
      <button class="secondary-button prompt-button soft-button" bindtap="onUseWechatNickname">获取微信昵称登录</button>
      <button class="primary-button prompt-button" loading="{{loading}}" bindtap="onConfirmNickname">
        {{loading ? '登录中...' : '登录'}}
      </button>
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>
  </view>
</view>
