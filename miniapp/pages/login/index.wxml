<view class="page login-page">
  <view class="hero-card login-card">
    <text class="login-kicker">Study English</text>
    <text class="login-title">把练习、复盘和 AI 讲解带进微信</text>
    <text class="login-description">
      现在的小程序已经覆盖总览、学习计划、练习答题、历史复盘、AI 讲解和设置中心。
    </text>

    <button class="primary-button" loading="{{loading}}" bindtap="onWechatLogin">
      {{loading ? '登录中...' : '微信一键登录'}}
    </button>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>
  </view>
</view>
