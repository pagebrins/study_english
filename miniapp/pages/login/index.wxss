.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at top, rgba(20, 184, 166, 0.18), transparent 38%),
    linear-gradient(180deg, #ecfeff 0%, #f8fafc 55%, #ffffff 100%);
}

.login-card {
  width: 100%;
  padding: 48rpx;
}

.login-kicker {
  display: inline-flex;
  margin-bottom: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #115e59;
  font-size: 22rpx;
  font-weight: 600;
}

.login-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #0f172a;
}

.login-description {
  display: block;
  margin: 20rpx 0 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475569;
}

.login-button {
  width: 100%;
}

.name-prompt-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(153, 246, 228, 0.8);
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
}

.name-prompt-head {
  margin-bottom: 20rpx;
}

.name-prompt-badge {
  display: inline-flex;
  margin-bottom: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(20, 184, 166, 0.12);
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 600;
}

.name-prompt-title {
  display: block;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.name-prompt-copy {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.name-helper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(236, 254, 255, 0.95), rgba(248, 250, 252, 0.95));
}

.name-helper-label {
  color: #64748b;
  font-size: 24rpx;
}

.name-helper-value {
  max-width: 55%;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.prompt-button {
  width: 100%;
  margin-top: 20rpx;
}

.text-button {
  display: block;
  width: 100%;
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
  text-align: center;
}
